<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.group27.controller.CustomerController" stylesheets="@../css/style.css">
    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" styleClass="liquid-glass-pane" style="-fx-padding: 10;">
            <Label fx:id="welcomeLabel" text="Welcome, User" styleClass="title-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" promptText="Search products..." prefWidth="300" onKeyReleased="#handleSearch"/>
            <Button text="My Cart" onAction="#openCart"/>
            <Button text="My Orders" onAction="#openOrders"/>
            <Button text="Logout" onAction="#handleLogout"/>
        </HBox>
    </top>
    
    <center>
        <SplitPane dividerPositions="0.7">
            <!-- Left Side: Products in TitledPanes -->
            <ScrollPane fitToWidth="true" fitToHeight="true">
                <Accordion expandedPane="$vegPaneTitled">
                    <panes>
                        <TitledPane fx:id="vegPaneTitled" text="Vegetables" styleClass="category-header-veg">
                             <FlowPane fx:id="vegPane" hgap="15" vgap="15" style="-fx-padding: 15;" alignment="TOP_LEFT"/>
                        </TitledPane>
                        <TitledPane fx:id="fruitPaneTitled" text="Fruits" styleClass="category-header-fruit">
                             <FlowPane fx:id="fruitPane" hgap="15" vgap="15" style="-fx-padding: 15;" alignment="TOP_LEFT"/>
                        </TitledPane>
                    </panes>
                </Accordion>
            </ScrollPane>
            
            <!-- Right Side: Messages & Extras (To keep clean layout) -->
            <ScrollPane fitToWidth="true" fitToHeight="true">
            <VBox spacing="10" style="-fx-padding: 20;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="My Profile" styleClass="title-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Toggle" onAction="#toggleProfile" style="-fx-font-size: 10px;"/>
                </HBox>

                <VBox fx:id="profileBox" spacing="10" managed="false" visible="false">
                    <TextField fx:id="editAddressField" promptText="Edit Address"/>
                    <PasswordField fx:id="editPasswordField" promptText="New Password"/>
                    <Button text="Update Profile" onAction="#updateProfile"/>
                </VBox>

                <Separator/>
                
                <!-- Loyalty Points & Coupons -->
                <VBox spacing="8" styleClass="liquid-glass-pane" style="-fx-padding: 10;">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="🎁 Loyalty Points:" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                        <Label fx:id="loyaltyPointsLabel" text="0" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #ef6c00;"/>
                    </HBox>
                    <Button text="View My Coupons" onAction="#openMyCoupons" maxWidth="Infinity" style="-fx-font-size: 11px;"/>
                    <Button text="Redeem Points for Coupon" onAction="#openCouponShop" maxWidth="Infinity" style="-fx-font-size: 11px;"/>
                </VBox>

                <Separator/>

                <Label text="Cart Preview" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                <ListView fx:id="miniCartList" prefHeight="120" minHeight="100" style="-fx-font-size: 11px;" visible="true" managed="true"/>
                
                <Separator/>
                
                <Label text="Messages" styleClass="title-label"/>
                <TextArea fx:id="messageInput" promptText="Write a message to the owner..." prefHeight="80" wrapText="true"/>
                <Button text="Send Message" onAction="#sendMessage"/>
                <Label text="Inbox:" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                <ListView fx:id="messageList" prefHeight="200" style="-fx-font-size: 11px; -fx-font-family: 'Monaco', 'Menlo', monospace;"/>
            </VBox>
            </ScrollPane>
        </SplitPane>
    </center>
</BorderPane>
